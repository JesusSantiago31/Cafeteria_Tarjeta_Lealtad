# Backend Environment Variables Template

# App Configuration
PROJECT_NAME="Cafeteria Loyalty Cards API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Supabase Configuration
# Replace with your actual Supabase project credentials
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-role-key"

# Security & Authentication
JWT_SECRET_KEY="change_this_to_a_secure_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Rate Limiting
DEFAULT_RATE_LIMIT="100/minute"

# Google Wallet Configuration (Google Pay & Wallet Console)
GOOGLE_ISSUER_ID="your_google_pay_issuer_id_here"
GOOGLE_CLIENT_EMAIL="your_service_account_email@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_rsa_private_key_here\n-----END PRIVATE KEY-----"
CAFETERIA_NAME="Cafetería Gourmet"
CAFETERIA_LOGO_URL="https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=400&q=80"
CAFETERIA_HERO_IMAGE_URL="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=1000&q=80"

