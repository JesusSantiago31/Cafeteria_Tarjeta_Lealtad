# =====================================================================
# TEMPLATE DE VARIABLES DE ENTORNO PARA VERCEL / PRODUCCIÓN
# Copia estos nombres de variables e introdúcelos en Vercel Dashboard:
# Project Settings -> Environment Variables
# =====================================================================

# Configuración General del Backend
PROJECT_NAME="Cafeteria Loyalty Cards API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
DEBUG=False

# Supabase (Base de Datos & Auth)
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_KEY="tu_supabase_anon_o_service_role_key"

# Seguridad & Tokens JWT Internos
JWT_SECRET_KEY="tu_clave_secreta_jwt_de_produccion"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Rate Limiting
DEFAULT_RATE_LIMIT="100/minute"

# Google Wallet Integration (Credenciales Sensibles de Google Cloud)
GOOGLE_ISSUER_ID="3388000000023191405"
GOOGLE_CLASS_ID="cafeteria_generic_v6"
GOOGLE_CLIENT_EMAIL="tu-cuenta-de-servicio@proyecto.iam.gserviceaccount.com"

# IMPORTANTE PARA LA CLAVE PRIVADA DE GOOGLE:
# En Vercel, asegúrate de pegar la clave completa con saltos de línea \n o como texto multilínea.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu_clave_privada_rsa_aqui...\n-----END PRIVATE KEY-----\n"

# Personalización Visual de la Tarjeta de Lealtad
CAFETERIA_NAME="Cafetería"
CAFETERIA_SUBHEADER="Datos de Cliente"
CAFETERIA_BG_COLOR="#69b07e"
CAFETERIA_LOGO_URL="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTBl6LKbfzoGTny4NdhmY6Sb918FWDa0NZ_8XNWPh5BjQ&s"
CAFETERIA_HERO_IMAGE_URL="https://img.freepik.com/vector-gratis/hermoso-banner-floral-plantilla-hojas_21799-2813.jpg?w=740&q=80"

# Variables del Frontend (Vite)
# Si despliegas Frontend y Backend en proyectos Vercel separados, coloca aquí la URL del Backend:
# VITE_API_URL="https://tu-backend.vercel.app/api/v1"
